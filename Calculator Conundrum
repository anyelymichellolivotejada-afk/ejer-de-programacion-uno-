    class simplecalculator
    {
        public int NUM1 { get; set; }
        public int NUM2 { get; set; }

        public string Operador { get; set; }

        // parámetros
        public string Calcular(int NUM1, int NUM2, string Operador)
        {
            if (string.IsNullOrWhiteSpace(Operador))
                throw new ArgumentException("El operador no puede estar vacío.", nameof(Operador));

            var op = Operador.Trim();

            switch (op)
            {
                case "+":
                    {
                        int res = NUM1 + NUM2;
                        return $"El resultado es {NUM1} + {NUM2} = {res}";
                    }
                case "-":
                    {
                        int res = NUM1 - NUM2;
                        return $"El resultado es {NUM1} - {NUM2} = {res}";
                    }
                case "*":
                    {
                        int res = NUM1 * NUM2;
                        return $"El resultado es {NUM1} * {NUM2} = {res}";
                    }
                case "/":
                    {
                        if (NUM2 == 0)
                            throw new DivideByZeroException("Error: la división no puede ser entre 0.");
                        int res = NUM1 / NUM2;
                        return $"El resultado es {NUM1} / {NUM2} = {res}";
                    }
                default:
                    throw new ArgumentOutOfRangeException(nameof(Operador), "El operador no está soportado (+, -, *, /).");
            }
        }


    }



